{
  "contractVersion": "route_iq_paid_customer_crm_workflow.v1",
  "owner": "Prometheus CRM",
  "purpose": "Versioned, company-and-workspace-scoped CRM workflow configuration for paid Route IQ customers.",
  "executionBoundary": {
    "mode": "local_configuration_projection",
    "productionMutationAuthorized": false,
    "notificationAuthorized": false,
    "customerActivationAuthorized": false,
    "customerRecordMutationAuthorized": false
  },
  "scope": {
    "required": [
      "companyId",
      "workspaceId"
    ],
    "immutableAcrossProvisioningPlan": true,
    "serverSideAuthorizationRequired": true,
    "clientFilteringIsAuthorization": false
  },
  "configuration": {
    "required": [
      "contractVersion",
      "configurationVersion",
      "companyId",
      "workspaceId",
      "industryTemplateId",
      "lifecycleState",
      "roles",
      "stages",
      "workflows",
      "metrics"
    ],
    "stableIdentifiers": [
      "roleId",
      "stageId",
      "workflowId",
      "transitionId",
      "metricId",
      "semanticKey"
    ],
    "displayLabelsAreIdentifiers": false,
    "unknownFieldsRejected": true,
    "unsafeLabelsRejected": true,
    "semanticMetricDriftRejected": true
  },
  "administrationProjection": {
    "sourceSchemaVersion": "route-iq-paid-customer-onboarding-v1",
    "sourceContractVersion": "1.0.0",
    "safeLifecycleStates": [
      "VALIDATED",
      "PREVIEW_READY",
      "AWAITING_APPROVAL"
    ],
    "scopeIdentityImmutable": true,
    "crossWorkspaceConfigurationAllowed": false,
    "configuredRolesOnly": true,
    "permissionMapping": "GOVERNED_CAPABILITY_ALLOWLIST_WITHOUT_ESCALATION",
    "unknownCapabilitiesRejected": true,
    "processAndFollowUpStageReferencesMustBeComplete": true,
    "configuredStageOrderMustBeMonotonic": true,
    "stableMetricHistoryRequired": true,
    "ambiguousMetricUnitsRejected": true,
    "productionMutationAuthorized": false,
    "notificationAuthorized": false,
    "customerActivationAuthorized": false
  },
  "lifecycleStates": [
    "draft",
    "validation_failed",
    "validated",
    "preview_ready",
    "awaiting_approval",
    "provisioning",
    "provisioning_failed",
    "ready_for_activation",
    "active",
    "suspended",
    "offboarded"
  ],
  "provisioning": {
    "planDeterministic": true,
    "operationsIdempotent": true,
    "attemptReplayRejected": true,
    "partialFailureRecovery": "RETRY_SAME_PLAN_WITH_FRESH_ATTEMPT_ID",
    "duplicateStagesAllowed": false,
    "duplicateRolesAllowed": false,
    "duplicateWorkflowsAllowed": false,
    "duplicateMetricsAllowed": false,
    "customerRecordsCreated": false
  },
  "audit": {
    "appendOnly": true,
    "hashChained": true,
    "displayLabelsStored": false,
    "credentialsStored": false,
    "freeFormFailureTextStored": false
  },
  "suspension": {
    "writesAllowed": false,
    "configurationRetained": true,
    "auditRetained": true
  },
  "offboarding": {
    "writesAllowed": false,
    "configurationRetained": true,
    "auditRetained": true,
    "destructiveDeletionAuthorized": false,
    "reactivationAuthorized": false
  }
}
