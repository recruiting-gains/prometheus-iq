        { "id": "credit_range_self_reported", "label": "credit range self-reported", "type": "string", "required": false, "sensitive": true },
        { "id": "number_of_locations_desired", "label": "number of locations desired", "type": "integer", "required": false },
        { "id": "readiness_assessment_status", "label": "readiness assessment status", "type": "enum", "required": true },
        { "id": "jr_handoff_status", "label": "JR handoff status", "type": "enum", "required": true },
        { "id": "protected_candidate_start_date", "label": "protected candidate start date", "type": "date", "required": false },
        { "id": "protected_candidate_expiration_date", "label": "protected candidate expiration date", "type": "date", "required": false },
        { "id": "commission_forecast", "label": "commission forecast", "type": "currency_estimate", "required": false },
