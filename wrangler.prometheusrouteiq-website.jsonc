{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prometheusrouteiq-website",
  "workers_dev": false,
  "preview_urls": false,
  "main": "workers/prometheus-iq-worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./deploy/prometheusrouteiq-website",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROUTE_IQ_REQUEST_CRM_COORDINATOR",
        "class_name": "RouteIqRequestCrmCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "route-iq-request-crm-sqlite-v1",
      "new_sqlite_classes": [
        "RouteIqRequestCrmCoordinator"
      ]
    }
  ],
  "vars": {
    "META_OAUTH_CALLBACK_URL": "https://prometheusrouteiq.com/api/oauth/meta/instagram/callback",
    "META_GRAPH_API_VERSION": "v21.0",
    "INSTAGRAM_API_MODE": "instagram_login",
    "INSTAGRAM_BUSINESS_ACCOUNT_ID": "17841421929598004",
    "INSTAGRAM_USER_ID": "17841421929598004",
    "INSTAGRAM_CONNECTION_VERIFIED_AT": "2026-07-01T23:18:58.005Z",
    "INSTAGRAM_GRANTED_SCOPES": "instagram_business_basic,instagram_business_manage_insights",
    "INSTAGRAM_ACCOUNT_HANDLE": "@prometheus.iq",
    "FOUNDER_NOTIFICATION_FROM": "intake@prometheusrouteiq.com",
    "FOUNDER_NOTIFICATION_TO": "prometheusrouteiq@gmail.com"
  },
  "kv_namespaces": [
    {
      "binding": "META_INSTAGRAM_TOKEN_STORE",
      "id": "9bc431ce712544bfa18dae1b6d59e19b"
    },
    {
      "binding": "AEGIS_RATE_LIMITS",
      "id": "1365393c0e534e44af87519e46ea1450"
    },
    {
      "binding": "SHARED_LEAD_INTAKE_STORE",
      "id": "5c78f078c68147f089f7b6423c99688c"
    },
    {
      "binding": "CRM_WORKSPACE_LEAD_STORE",
      "id": "f20a0a4f66fb4b53ab26644e2d3bd0dd"
    }
  ],
  "send_email": [
    {
      "name": "FOUNDER_EMAIL",
      "destination_address": "prometheusrouteiq@gmail.com"
    }
  ]
}
