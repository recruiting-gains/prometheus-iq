  "policyVersion": "off-route-learning-intelligence-v1-policy-v1",
  "status": "active_read_only_observation",
  "ownerSubsystem": "Prometheus Intelligence Engine",
  "workspaceId": "fitness_connection",
  "operatingProfileId": "fitness",
  "sourceTaxonomy": [
    {
      "sourceId": "route_iq_recommendation",
      "label": "Route IQ Recommendation",
      "sourceClass": "system_recommendation",
      "offRoute": false,
      "representativeJudgment": false,
