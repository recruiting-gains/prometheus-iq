      "aliases": ["representative_saved_place", "Representative Saved Place", "saved_place"]
    },
    {
      "sourceId": "representative_discovery",
      "label": "Representative Discovery",
      "sourceClass": "representative_judgment",
      "offRoute": true,
      "representativeJudgment": true,
      "aliases": ["representative_discovery", "Representative Discovery", "field_discovery"]
    },
    {
      "sourceId": "representative_follow_up",
      "label": "Representative Follow-up",
      "sourceClass": "representative_judgment",
      "offRoute": true,
