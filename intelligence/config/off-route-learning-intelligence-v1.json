      "aliases": ["existing_relationship", "Existing Relationship"]
    },
    {
      "sourceId": "unknown",
      "label": "Unknown",
      "sourceClass": "unknown",
      "offRoute": null,
      "representativeJudgment": false,
      "aliases": ["unknown", "Unknown"]
    }
  ],
  "sourceAdmission": {
    "explicitStructuredEvidenceRequired": true,
    "requiredKnownSourceFields": ["sourceId", "reason", "evidence", "confidence", "capturedAt"],
    "minimumKnownSourceConfidence": 0.5,
    "unknownFallbackRequired": true,
    "unsupportedSourceFailsToUnknown": true,
    "notesInferenceAllowed": false,
    "businessSourceTypeInferenceAllowed": false,
    "outcomeInferenceAllowed": false,
    "recommendationAvailabilityInferenceAllowed": false
  },
  "recommendationDecisionPolicy": {
    "decisionValues": ["accepted", "overridden"],
    "recommendationAvailableRequired": true,
    "recommendationIdRequired": true,
    "overrideRequiresOffRouteSource": true,
    "offRouteVisitAutomaticallyCountsAsOverride": false,
    "unknownSourceIncludedInDecisionRates": false
  },
  "successPolicy": {
    "strategy": "any_verified_signal_meets_minimum",
    "signals": {
      "leads": 1,
      "units": 1,
      "laterUnits": 1,
      "appointments": 1,
      "sales": 1,
      "contracts": 1,
      "referrals": 1
    },
    "missingOutcomeRemainsUnknown": true,
    "outcomeLabelAloneCountsAsSuccess": false
  },
  "evidenceThresholds": {
    "minimumKnownSourceVisits": 5,
    "minimumRecommendationDecisions": 5,
    "minimumOverrideOutcomes": 3,
    "minimumDiscoveryOutcomes": 3,
    "minimumRepresentativeJudgmentOutcomes": 5,
    "minimumComparisonOutcomesPerCohort": 5,
    "minimumLearningConfidence": 0.7,
    "minimumRepresentativeJudgmentConfidence": 0.7
  },
  "confidenceModel": {
    "weights": {
      "sourceCoverage": 0.35,
      "outcomeCoverage": 0.2,
      "recommendationDecisionCoverage": 0.25,
      "sampleMaturity": 0.2
    },
    "bands": [
      {"band": "insufficient_evidence", "minimum": 0},
      {"band": "developing", "minimum": 0.35},
      {"band": "medium", "minimum": 0.6},
      {"band": "high", "minimum": 0.8}
    ]
  },
  "recommendationInfluence": {
    "activationStatus": "disabled_observation_only",
    "routeScoringWeightMutationAllowed": false,
    "routeGenerationMutationAllowed": false,
    "recommendationMutationAllowed": false,
    "automaticLearningInfluenceAllowed": false
  },
  "outputPolicy": {
    "artifactMode": "deterministic_read_only_projection",
    "unknownRatesUseNull": true,
    "zeroDenominatorReportedAsZero": false,
    "unmetThresholdsRemainVisible": true,
    "sourceCoverageRequired": true,
    "overrideExplainabilityRequired": true
  }
}
