{
  "version": "route-iq-business-hours-eligibility-contracts-v2",
  "runtimeVersion": "route-iq-business-hours-eligibility-v2",
  "compatibility": {
    "supersedesRuntimeVersion": "route-iq-closed-now-eligibility-v1",
    "supersedesContractVersion": "route-iq-closed-now-eligibility-contracts-v1",
    "exactVersionRequired": true,
    "legacyRuntimeVersionAccepted": false,
    "legacyContractVersionAccepted": false,
    "breakingChanges": [
      "coverage_and_immediate_eligibility_are_separate",
      "manifest_admission_and_provenance_are_required",
      "availability_and_visit_duration_have_distinct_output_semantics",
      "persisted_queue_entries_are_re_evaluated_at_authoritative_time"
    ]
  },
  "admissionVersion": "route-iq-governed-business-admission-v2",
  "subsystem": "prometheus-intelligence-engine",
  "domain": "route-intelligence",
  "recommendationInfluence": "OFF",
  "collection": "OFF",
  "activeCohorts": 0,
  "configurationContract": {
    "administrationSchemaVersion": "route-iq-workspace-configuration-v2",
    "supportedCanonicalWorkspaces": [
      "fitness_connection",
      "northstar_outside_sales_synthetic"
    ],
    "companyNameBranchingAllowed": false,
    "callerScopeMutationAllowed": false,
    "unknownOrInvalidConfigurationBehavior": "fail_closed",
    "demoOrFallbackCatalogAllowed": false
  },
  "dataContract": {
    "manifestRegistry": "data/route-iq-commercial-readiness-v1/route-iq-workspace-business-artifact-manifest-registry-v1.json",
    "manifestVersion": "route-iq-workspace-business-artifact-manifest-v1",
    "requiredExactBindings": [
      "workspaceId",
      "operatingProfileId",
      "administrationConfigurationVersion",
      "manifestConfigurationVersion",
      "manifestId",
      "manifestVersion",
      "artifactSha256",
      "classification",
      "approvalState",
      "candidateIdentity",
      "territoryId"
    ],
    "businessRecordsSource": "approved_tenant_company_manifest_only",
    "dataOwnsScheduleAndProvenance": true,
    "intelligenceOwnsEligibility": true,
    "sourceRecordsModified": false
  },
  "governedRuntimeScope": {
    "version": "route-iq-governed-runtime-scope-v1",
    "requiredAdmissionVersion": "route-iq-governed-business-admission-v2",
    "requiredAssetType": "business_hours",
    "requiredAuthorizations": [
      "business_hours_eligibility",
      "continuous_adaptive_route_replenishment"
    ],
    "canonicalManifestAdmissionRequired": true,
    "callerAuthorizationClaimsAccepted": false,
    "workspaceProfileTerritorySubstitutionBehavior": "fail_closed",
    "serializedScopeReuse": "rejected"
  },
  "eligibilityPolicy": {
    "coverageAndEvaluationSeparated": true,
    "OPEN_VERIFIED": {
      "coverageEligible": true,
      "immediateRecommendationEligible": true,
      "selectionTier": 0,
      "representation": "verified_open"
    },
    "CLOSED_VERIFIED": {
      "coverageEligible": true,
      "immediateRecommendationEligible": false,
      "selectionTier": 99,
      "retainNextOpening": true
    },
    "HOURS_STALE": {
      "coverageEligible": true,
      "immediateRecommendationEligible": false,
      "selectionTier": 99,
      "internalMarker": "HOURS_NOT_VERIFIED"
    },
    "HOURS_UNKNOWN": {
      "coverageEligible": false,
      "immediateRecommendationEligible": false,
      "selectionTier": 99,
      "internalMarker": "HOURS_NOT_VERIFIED"
    },
    "SPECIAL_HOURS_UNVERIFIED": {
      "coverageEligible": true,
      "immediateRecommendationEligible": false,
      "selectionTier": 99,
      "internalMarker": "HOURS_NOT_VERIFIED"
    },
    "PROVIDER_FAILURE": {
      "coverageEligible": true,
      "immediateRecommendationEligible": false,
      "selectionTier": 99
    },
    "INVALID": {
      "coverageEligible": false,
      "immediateRecommendationEligible": false,
      "selectionTier": 99
    },
    "appointmentOnlyRequiresVerifiedCurrentAccessWindow": true,
    "maximumFreshnessHours": 24,
    "uncertainHoursMayBeGuessedOpen": false
  },
  "queuePolicy": {
    "evaluationPoints": [
      "initial_generation",
      "persisted_entry_restoration",
      "adaptive_replenishment",
      "route_regeneration",
      "fallback_selection"
    ],
    "authoritativeEvaluationTimeRequired": true,
    "selectionOrder": [
      "active_fresh_verified_open",
      "approved_fallback_fresh_verified_open"
    ],
    "uncertainCoverageSelectableAsCurrentStop": false,
    "persistedNowStaleRankOneRetained": false,
    "emptyPoolBehavior": "explicit_safe_exhausted_state"
  },
  "presentationContract": {
    "requiredAvailabilityFields": [
      "status",
      "localTimezone",
      "effectiveInterval",
      "nextClosing",
      "nextOpening",
      "verifiedAt",
      "expiresAt",
      "freshness",
      "sourceState",
      "sourceSystem",
      "display"
    ],
    "visitDurationSeparate": true,
    "visitDurationLabelPrefix": "Estimated visit:",
    "representativeFacingShadowOutput": false
  },
  "safety": {
    "scoringWeightsChanged": false,
    "liveProviderCalls": false,
    "workspaceProfileTerritoryIsolation": "fail_closed",
    "approvedRosterRequired": true,
    "providerFailureMayPromoteStaleData": false,
    "recommendationInfluenceChanged": false,
    "collectionChanged": false,
    "cohortsChanged": false
  }
}
