{
  "version": "continuous-adaptive-route-replenishment-contracts-v1",
  "subsystem": "prometheus-intelligence-engine",
  "domain": "route-intelligence",
  "workspacePolicy": {
    "configurationSchemaVersion": "route-iq-workspace-configuration-v2",
    "canonicalWorkspaceIds": [
      "fitness_connection",
      "northstar_outside_sales_synthetic"
    ],
    "configurationDriven": true,
    "companyNameBranchingAllowed": false,
    "runtimeScopeVersion": "route-iq-governed-runtime-scope-v1",
    "businessAdmissionVersion": "route-iq-governed-business-admission-v2",
    "canonicalManifestAdmissionRequired": true,
    "callerAuthorizationClaimsAccepted": false,
    "serializedScopeReuse": "rejected",
    "unknownWorkspaceBehavior": "fail_closed",
    "crossWorkspaceLearning": false,
    "crossWorkspaceRouteInfluence": false
  },
  "queuePolicy": {
    "targetSize": 15,
    "replenishmentThreshold": 5,
    "outcomeTriggersImmediateMaintenance": true,
    "preserveRemainingOrder": true,
    "appendReplacement": true,
    "completedStopExclusion": "current_route_date",
    "duplicateIdentity": "manifest_identity_then_stable_route_identity",
    "concurrency": "single_flight",
    "candidateScan": "bounded",
    "emptyPoolBehavior": "explicit_safe_exhausted_state",
    "persistedEntriesReevaluatedAtAuthoritativeTime": true
  },
  "candidatePolicy": {
    "primaryPool": "approved_active",
    "fallbackPool": "approved_full",
    "fallbackActivation": "only_after_no_immediate_eligible_active_candidate_can_fill_queue",
    "liveProviderCalls": false,
    "requiredAdmission": [
      "workspace_match",
      "operating_profile_match",
      "territory_match",
      "manifest_id_and_version_match",
      "manifest_artifact_hash_match",
      "administration_configuration_version_match",
      "manifest_configuration_version_match",
      "classification_match",
      "approved_candidate_identity"
    ],
    "requiredImmediateEligibility": [
      "fresh",
      "open_verified_or_verified_current_access_window",
      "route_rules_pass",
      "not_quarantined",
      "not_completed_current_route",
      "not_already_active"
    ],
    "selectionOrder": [
      "approved_active_fresh_verified_open",
      "approved_full_fresh_verified_open"
    ],
    "closedStaleMissingInvalidOrProviderFailureSelectable": false,
    "appointmentOnlyRequiresVerifiedCurrentAccessWindow": true
  },
  "latestEvidenceInputs": [
    "representative_strengths_weaknesses",
    "logged_visit_outcomes",
    "industry_category_performance",
    "territory_performance",
    "time_of_day_performance",
    "business_customer_behavior",
    "follow_up_status",
    "objection_patterns",
    "closing_patterns",
    "distance_route_context",
    "workspace_specific_evidence"
  ],
  "persistence": {
    "visitOutcomeBeforeRegeneration": true,
    "queueScopedBy": [
      "workspace_id",
      "representative_id",
      "route_date",
      "operating_profile_id"
    ],
    "completedHistoryPreserved": true,
    "separateRuntimeOperationsSupported": true,
    "availabilityReevaluatedOnRestore": true
  },
  "consumerCompatibility": {
    "dashboard": "active_queue_projection",
    "mobile": "active_queue_projection",
    "recommendationExplanations": "existing_route_intelligence_contract",
    "manualRouteRebuildRequired": false,
    "fullApplicationRestartRequired": false,
    "downstreamManifestContextRequired": true
  },
  "safety": {
    "collection": "OFF",
    "activeCohorts": 0,
    "recommendationInfluence": "OFF",
    "representativeFacingShadowOutput": false
  }
}
