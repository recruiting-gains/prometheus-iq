{
  "schemaVersion": "route-iq-paid-customer-intelligence-contract-v1",
  "owner": "Prometheus Intelligence Engine",
  "implementation": "intelligence/route-iq-paid-customer-intelligence.mjs",
  "consumes": {
    "onboarding": "route-iq-paid-customer-onboarding-v1",
    "onboardingContractVersion": "1.0.0",
    "onboardingAuthority": "prometheus_administration",
    "configurationIdentity": "provenance.configurationIdentity",
    "companyIdentity": "company.companyId",
    "workspaceIdentity": "company.workspaceId",
    "territory": "territory",
    "metricDefinitions": "terminology.metrics",
    "metricLabels": "terminology.terms",
    "verifiedBusinessEvidence": "route-iq-verified-business-evidence-v1"
  },
  "scope": {
    "companyIdentityImmutable": true,
    "workspaceIdentityImmutable": true,
    "serverAuthenticatedPrincipalRequired": true,
    "crossCompanyEnumerationAllowed": false,
    "crossWorkspaceInferenceAllowed": false
  },
  "admissionGates": [
    "configuration_version",
    "company_scope",
    "workspace_scope",
    "approved_territory",
    "approved_zip",
    "included_category",
    "business_exclusion",
    "verified_identity",
    "physical_address",
    "current_operating_status",
    "verified_open_or_access_window",
    "provider_success",
    "freshness",
    "duplicate_resolution",
    "conflict_resolution",
    "target_profile_match",
    "evidence_quality"
  ],
  "failClosedStates": [
    "missing",
    "stale",
    "invalid",
    "closed",
    "provider_failed",
    "outside_territory",
    "excluded",
    "duplicated",
    "conflicting",
    "cross_company",
    "cross_workspace"
  ],
  "authorization": {
    "configuredRoleIdRequired": true,
    "customerRoleNamesHardCoded": false,
    "operations": {
      "RECOMMENDATION_ADMISSION": [
        "view_assigned_territory",
        "view_company_dashboard"
      ],
      "CONFIGURATION_PREVIEW": [
        "view_company_dashboard"
      ]
    }
  },
  "lifecycle": {
    "acceptedInactiveStates": [
      "VALIDATED",
      "PREVIEW_READY",
      "AWAITING_APPROVAL",
      "READY_FOR_ACTIVATION"
    ],
    "draftAccepted": false,
    "failureStateAccepted": false,
    "activeAcceptedWithoutSeparateActivation": false,
    "suspendedAccepted": false,
    "offboardedAccepted": false
  },
  "metricModel": {
    "stableInternalIdentifiers": true,
    "displayLabelsSeparate": true,
    "singularPluralRequired": true,
    "semanticVersionRequired": true,
    "historyIdentityRequired": true,
    "historicalSnapshotsImmutable": true,
    "controlledGenericFallbackOnly": true,
    "customerSpecificCodeBranchesAllowed": false
  },
  "industryTemplates": [
    "gym_sales",
    "medical_business_development",
    "security_services",
    "franchise_development",
    "merchant_payroll_services",
    "commercial_distribution"
  ],
  "safety": {
    "collection": "OFF",
    "activeCohorts": 0,
    "recommendationInfluence": "OFF",
    "customerActivation": "OFF",
    "routeOrderingChanged": false,
    "routeScoringWeightsChanged": false
  }
}
