  "contracts": {
    "FranchiseCandidateSourcing": {
      "purpose": "Plan how Smoothie Depot franchise-owner candidates are identified without mixing with Fitness Connection route data.",
      "requiredFields": ["candidateSourceId", "workspaceId", "sourceType", "sourceName", "candidateRefs", "researchStatus", "generatedBy", "generatedAt", "isolationState"]
    },
    "BusinessProspectResearch": {
      "purpose": "Plan business prospect research for candidate fit, ownership context, geography, industry background, and expansion relevance.",
      "requiredFields": ["researchId", "workspaceId", "candidateRef", "businessRefs", "researchQuestions", "sourceRefs", "confidence", "reviewState"]
    },
    "FranchiseReadinessAssessment": {
      "purpose": "Plan readiness scoring language without production scoring automation.",
      "requiredFields": ["assessmentId", "workspaceId", "candidateRef", "readinessFactors", "evidenceRefs", "confidence", "humanReviewRequired", "allowedInfluence"]
    },
    "CandidateIntelligenceProfile": {
      "purpose": "Plan the candidate intelligence record for qualification and JR handoff.",
      "requiredFields": ["profileId", "workspaceId", "candidateRef", "businessBackground", "capitalSignals", "territoryInterest", "fitSummary", "risks", "nextAction", "provenance"]
    },
    "SmoothieDepotCrmPipelineStages": {
      "purpose": "Plan CRM stages without implementing CRM runtime.",
      "requiredFields": ["workspaceId", "operatingProfileId", "stages", "entryCriteria", "exitCriteria", "runtimeMutationAuthorized"]
    },
    "SmoothieDepotDashboardDisplayNeeds": {
      "purpose": "Plan Dashboard display needs without Dashboard runtime changes.",
      "requiredFields": ["workspaceId", "views", "fields", "filters", "badges", "runtimeConsumptionAuthorized"]
    },
    "JrHandoffPackage": {
      "purpose": "Plan the package Cruz can hand to JR for candidate review.",
      "requiredFields": ["handoffId", "workspaceId", "decisionMaker", "candidateRef", "summary", "evidenceRefs", "recommendedAsk", "protectionStatus", "commissionStatus"]
    },
    "CommissionTracking": {
      "purpose": "Plan commission tracking for protected candidate outcomes without financial automation.",
      "requiredFields": ["commissionId", "workspaceId", "candidateRef", "triggerEvent", "estimatedValue", "status", "evidenceRefs", "reviewState"]
    },
    "CandidateProtectionPeriod": {
      "purpose": "Plan candidate protection windows and review state.",
      "requiredFields": ["protectionId", "workspaceId", "candidateRef", "startDate", "endDate", "protectedBy", "handoffRef", "status", "reviewState"]
    },
    "WorkspaceIsolationGuardrails": {
      "purpose": "Prevent Smoothie Depot planning data from affecting Fitness Connection or route intelligence.",
      "requiredFields": ["workspaceId", "protectedWorkspaceIds", "blockedInfluencePaths", "allowedSharedLayers", "routeIntelligenceInfluence", "fitnessConnectionIsolationConfirmed"]
    }
  },
  "prohibitions": [
    "no_fitness_connection_data_touch",
    "no_fitness_connection_route_intelligence_influence",
    "no_smoothie_depot_to_fitness_connection_learning",
    "no_dashboard_runtime_changes",
