{
  "contractVersion": "route-iq-private-paid-customer-browser-acceptance-v1",
  "ownerSubsystem": "Prometheus Infrastructure",
  "releaseLane": "github-actions-private-worker-deployment-v2",
  "targetWorker": "prometheus-iq",
  "authentication": {
    "type": "Cloudflare Access service principal",
    "clientIdSource": "CLOUDFLARE_ACCESS_CLIENT_ID",
    "clientSecretSource": "CLOUDFLARE_ACCESS_CLIENT_SECRET",
    "valuesMayBePrintedLoggedOrReturned": false
  },
  "viewports": [
    {
      "name": "desktop",
      "width": 1440,
      "height": 900
    },
    {
      "name": "mobile",
      "width": 390,
      "height": 844
    }
  ],
  "network": {
    "allowedMethods": [
      "GET",
      "HEAD",
      "OPTIONS"
    ],
    "writeAttemptsRequired": 0,
    "browserVersionStability": {
      "scriptExecutionAllowed": false,
      "cacheAllowed": false,
      "requiredConsecutiveExactProbes": 3,
      "maximumAttempts": 10,
      "delayMilliseconds": 1500,
      "probeTimeoutMilliseconds": 15000,
      "nonReadRequestsAllowed": 0,
      "externalRequestsAllowed": 0,
      "applicationExecutionBeforeStabilityAllowed": false
    },
    "applicationDocumentIdentityGate": {
      "responsePausedBeforeApplicationExecution": true,
      "cacheAllowed": false,
      "acceptedStatus": "2XX",
      "exactWorkerVersionRequired": true,
      "exactSmokeMarkerRequired": true,
      "mismatchResponseExecutionAllowed": false,
      "failureBehavior": "BLOCK_RESPONSE"
    },
    "externalOriginsAllowed": false,
    "serviceWorkerBypassRequired": true,
    "serviceWorkerPersistenceAllowed": false,
    "sameOriginHttp4xxOr5xxAllowed": false,
    "sameOriginAuthenticatedRequests": {
      "servicePrincipalHeadersRequired": true,
      "governedReadOnlyMarkerRequiredOnEveryRequest": true,
      "documentOnlyMarkerAllowed": false,
      "unmarkedPrivilegedRequestAllowed": false
    },
    "guardedServiceWorkerNetworkLogAcceptance": {
      "source": "network",
      "exactPath": "/sw.js",
      "correlatedBlockedRequestRequired": true,
      "allServiceWorkerRequestsBlockedRequired": true,
      "persistedRegistrationCountRequired": 0,
      "allOtherBrowserErrorsAllowed": false
    },
    "browserManagedIconAuthenticatedResourceBridge": {
      "exactOrigin": "https://prometheus-iq.prometheusrouteiq.workers.dev",
      "exactPath": "/icons/prometheus.svg",
      "queryAllowed": false,
      "resourceType": "Other",
      "method": "GET",
      "redirectMode": "manual",
      "acceptedStatus": "2XX",
      "acceptedContentType": "image/svg+xml",
      "maximumResponseBytes": 16384,
      "maximumAttemptsPerViewport": 1,
      "governedReadOnlyMarkerRequired": true,
      "retryAllowed": false,
      "syntheticBodyAllowed": false,
      "credentialLoggingAllowed": false,
      "responseBodyLoggingAllowed": false,
      "failedBridgeIsFatal": true,
      "allOtherHttpOrBrowserErrorsAllowed": false
    }
  },
  "acceptance": {
    "exactPrivateWorkerVersionRequired": true,
    "exactSmokeGuardMarkerRequired": true,
    "configuredOrSafeEmptyStateRequired": true,
    "horizontalOverflowAllowed": false,
    "consoleErrorsAllowed": 0,
    "runtimeExceptionsAllowed": 0,
    "networkFailuresAllowed": 0,
    "networkHttpFailuresAllowed": 0,
    "publicWorkerIdentityMustRemainExact": true
  },
  "diagnostics": {
    "allMatchingFailureDimensionsReported": true,
    "consoleSourceClassifications": [
      "CONSOLE_API",
      "LOG_NETWORK",
      "LOG_SECURITY",
      "LOG_JAVASCRIPT",
      "LOG_RENDERING",
      "LOG_WORKER",
      "LOG_DEPRECATION",
      "LOG_VIOLATION",
      "LOG_INTERVENTION",
      "LOG_RECOMMENDATION",
      "LOG_OTHER"
    ],
    "httpStatusClassifications": [
      "4XX",
      "5XX"
    ],
    "httpPathClassifications": [
      "ROOT",
      "FAVICON",
      "SERVICE_WORKER",
      "MANIFEST",
      "ICON",
      "APP_ASSET",
      "API",
      "OTHER"
    ],
    "unknownPathCollapsesToOther": true,
    "rawMessagesUrlsHeadersStacksOrCredentialsAllowed": false
  },
  "safety": {
    "productionWritesAllowed": false,
    "crmSubmissionAllowed": false,
    "collection": "OFF",
    "activeCohorts": 0,
    "recommendationInfluence": "OFF",
    "providerRefresh": "OFF",
    "scheduler": "OFF",
    "customerActivation": "OFF"
  }
}
