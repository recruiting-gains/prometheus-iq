{
  "version": "route-iq-request-crm-infrastructure-v1",
  "owner": "Prometheus Infrastructure",
  "publicIntake": {
    "path": "/api/partner-intake",
    "method": "POST",
    "workspaceId": "prometheus_route_iq",
    "operatingProfileId": "route_iq_commercial",
    "legacyFitnessRoutingActive": false,
    "legacySmoothieRoutingActive": false
  },
  "storage": {
    "binding": "ROUTE_IQ_REQUEST_CRM_COORDINATOR",
    "className": "RouteIqRequestCrmCoordinator",
    "migrationTag": "route-iq-request-crm-sqlite-v1",
    "backend": "sqlite_backed_durable_object",
    "atomicPutIfAbsent": "durable_object_storage_transaction",
    "kvCasClaimed": false,
    "deploymentTarget": "prometheusrouteiq-website Worker only",
    "privateWorkerBinding": false,
    "productionProvisioned": false
  },
  "founderAccess": {
    "paths": [
      "/api/partner-intake/founder/requests",
      "/api/partner-intake/founder/requests/{receiptId}",
      "/api/partner-intake/founder/export"
    ],
    "methods": ["GET"],
    "authorization": "verified_cloudflare_access_subject_sha256_to_immutable_principal",
    "jwtValidation": {
      "version": "route-iq-request-founder-jwt-validation-v2",
      "assertionHeader": "Cf-Access-Jwt-Assertion",
      "issuer": "exact_protected_team_domain",
      "audience": "exact_protected_application_audience",
      "jwks": "exact_team_domain_cdn_cgi_access_certs",
      "algorithms": ["RS256"],
      "requiredClaims": ["iss", "aud", "sub", "iat", "exp"],
      "notBefore": "validated_when_present",
      "clockToleranceSeconds": 5,
      "immutableSubjectSha256Required": true,
      "failClosed": true
    },
    "safeFailureCodes": [
      "route_iq_request_founder_auth_algorithm_invalid",
      "route_iq_request_founder_auth_audience_mismatch",
      "route_iq_request_founder_auth_claim_missing",
      "route_iq_request_founder_auth_invalid",
      "route_iq_request_founder_auth_issuer_mismatch",
      "route_iq_request_founder_auth_jwks_invalid",
      "route_iq_request_founder_auth_jwks_timeout",
      "route_iq_request_founder_auth_jwks_unavailable",
      "route_iq_request_founder_auth_signature_invalid",
      "route_iq_request_founder_auth_signing_key_unknown",
      "route_iq_request_founder_auth_token_expired",
      "route_iq_request_founder_auth_token_malformed",
      "route_iq_request_founder_auth_token_premature"
    ],
    "verification": {
      "bundledPublicEntrypoint": "workers/infrastructure/prometheusrouteiq-website-entry.mjs",
      "workerCompatibleRuntime": "Miniflare",
      "remoteJwksFetchExercised": true,
      "remoteJwksKeySelectionExercised": true,
      "externalNetworkRequired": false,
      "networkFailureClassified": true,
      "timeoutClassified": true,
      "unknownKeyClassified": true
    },
    "failureDetailsDisclosed": false,
    "displayNameAuthorization": false,
    "representativeAccess": false,
    "anthony": "pending_exact_authenticated_identity_mapping"
  },
  "notification": {
    "afterDurablePersistence": true,
    "contactPiiIncluded": false,
    "deliveryFailureIsMonitored": true
  },
  "capacityTarget": {
    "workspaceCount": 10,
    "totalUsers": 100,
    "concurrentUsers": 25,
    "claim": "verified_safe_initial_test_capacity_only"
  },
  "boundaries": {
    "prospectiveCollection": "OFF",
    "activeCohorts": 0,
    "recommendationInfluence": "OFF",
    "prospectiveRuntimeFilesChanged": false,
    "deploymentPerformed": false,
    "productionMutationPerformed": false
  }
}
