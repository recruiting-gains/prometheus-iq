    "trigger": "workflow_dispatch",
    "protectedEnvironment": "prometheus-private-worker-production",
    "founderActor": "PrometheusRouteIQ",
    "requiredBranch": "main",
    "requiredRunAttempt": 1,
    "concurrencyGroup": "deploy-prometheus-private-worker-v2",
    "rebuildAllowed": false,
    "artifactSubstitutionAllowed": false,
    "wranglerMode": "no-bundle",
    "keepVars": true,
    "strict": true,
    "workerNameOverrideAllowed": false,
    "forwardDeploymentAttempts": 1,
    "automaticRetryAllowed": false
