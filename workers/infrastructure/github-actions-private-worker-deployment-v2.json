      "runtimeGuardVersionMetadataAdditionAllowed": "CF_VERSION_METADATA",
      "unexpectedAdditionsAllowed": false,
      "deletionsAllowed": false,
      "typeChangesAllowed": false,
      "rollbackPreservesTransitionBindings": true
    },
    "secretCreateUpdateDeleteAllowed": false,
    "nativeCloudflareRollbackAllowed": false
  },
  "smoke": {
    "authentication": "cloudflare_access_service_principal",
    "methods": [
      "GET",
      "HEAD"
    ],
    "writeMethodsAllowed": false,
    "serviceWorkerWritesAllowed": false,
    "formSubmissionAllowed": false,
    "attemptedApplicationWritesRequired": 0,
    "successStatusClass": "2xx",
    "redirectsAllowed": false,
    "fixedAllowlistContract": "workers/infrastructure/cloudflare-unattended-smoke-contract.js",
    "bootstrap": {
      "oneTimeTransition": true,
      "currentPrivateVersionWithoutGuard": "9ffb32d3-313a-4209-ad1d-0a6702ba8a83",
      "accessServiceTokenRequired": true,
      "guardRequestMarkerSent": true,
      "guardResponseMarkerMayBeOmittedOnlyForPinnedCurrentVersion": true,
      "unexpectedGuardResponseMarkerAllowed": false
    },
    "postDeployment": {
      "exactGuardResponseMarkerRequired": true,
      "propagationFence": {
        "scope": "full_fixed_get_head_plan",
        "concurrentRequestsPerAttempt": true,
        "fixedNonsecretProbeClassification": true,
        "retryableConditions": [
          "2xx_guard_marker_missing",
          "2xx_exact_guard_marker_worker_version_missing",
          "2xx_exact_guard_marker_stale_worker_version"
        ],
        "expectedReleaseIdentity": "cloudflare_worker_version_id",
        "versionMetadataBinding": "CF_VERSION_METADATA",
        "versionResponseHeader": "X-Prometheus-Private-Worker-Version",
        "maxAttempts": 12,
        "delayMilliseconds": 1500,
        "requestTimeoutMilliseconds": 2500,
        "maximumWaitMilliseconds": 46500,
        "unsafeResponseRetryAllowed": false,
        "requestAndResponseLifecycleDeadlineEnforced": true,
        "fullSmokeRequestLifecycleDeadlineEnforced": true,
        "responseBodiesConsumedOrCancelled": true,
        "releaseIdentityValueLogged": false,
        "finalExactWholePlanAttemptIsAcceptance": true,
        "fullFixedSmokeRunsAfterReadiness": false,
        "timeoutTriggersForwardRollback": true
      }
    },
    "crmSubmissionAllowed": false,
    "notificationAllowed": false
  },
  "runtimeGuardInjection": {
    "artifactMutationAllowed": false,
    "applicationWorkerMutationAllowed": false,
    "applicationAssetsMutationAllowed": false,
    "commandLineValueInjectionAllowed": false,
    "sourceValueStorageAllowed": false,
    "logValueOutputAllowed": false,
    "artifactValueOutputAllowed": false,
    "temporaryDirectoryMode": "0700",
    "temporaryConfigMode": "0600",
    "temporaryBaseSource": "node:os.tmpdir()",
    "defaultTemporaryBaseCanonicalized": true,
    "explicitTemporaryBaseAliasesAllowed": false,
    "runnerTempEnvironmentAliasAllowed": false,
    "exclusiveCreateRequired": true,
    "symlinksAllowed": false,
    "cleanupRequiredInFinally": true,
    "wranglerScratch": {
      "directoryName": "wrangler-scratch",
      "location": "runtime-workspace-sibling-of-forward-and-rollback",
      "directoryMode": "0700",
      "outdirNames": {
        "dry-run": "dry-run",
        "deploy": "deploy",
        "rollback": "rollback"
      },
      "outdirsDistinct": true,
      "outdirsUserControlled": false,
      "outdirFlagRequiredForEveryPhase": true,
      "guardedRootMutationAllowed": false,
      "dotWranglerAllowlistedInGuardedRoots": false,
      "cleanupWithRuntimeWorkspace": true
    },
    "enabledValue": "ON",
    "teamDomainSource": "PROMETHEUS_UNATTENDED_SMOKE_ACCESS_TEAM_DOMAIN",
    "audienceSource": "PROMETHEUS_UNATTENDED_SMOKE_ACCESS_AUDIENCE",
    "serviceTokenClientIdSource": "CLOUDFLARE_ACCESS_CLIENT_ID",
    "versionMetadataBinding": "CF_VERSION_METADATA",
    "plainTextSettings": [
      "PROMETHEUS_UNATTENDED_SMOKE_GUARD",
      "PROMETHEUS_UNATTENDED_SMOKE_ACCESS_TEAM_DOMAIN",
      "PROMETHEUS_UNATTENDED_SMOKE_ACCESS_AUDIENCE",
      "PROMETHEUS_UNATTENDED_SMOKE_SERVICE_TOKEN_CLIENT_ID"
    ]
  },
  "failureClassification": {
