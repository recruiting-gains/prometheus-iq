    "preAuthorizationCloudflareReadScope": "exact_public_and_private_worker_identity_and_binding_prerequisites_only",
    "preAuthorizationCloudflareMutationRequestsAllowed": false
  },
  "protectedEnvironment": {
    "requiredSecretNames": [
      "CLOUDFLARE_API_TOKEN",
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_ACCESS_CLIENT_ID",
      "CLOUDFLARE_ACCESS_CLIENT_SECRET",
      "PROMETHEUS_UNATTENDED_SMOKE_ACCESS_TEAM_DOMAIN",
      "PROMETHEUS_UNATTENDED_SMOKE_ACCESS_AUDIENCE"
    ],
    "valuesInSourceAllowed": false,
    "valuesInLogsAllowed": false,
    "externalPresenceStateEmbeddedInSource": false,
    "missingRequiredNameFailure": "REQUIRED_PROTECTED_SECRET_NAMES_MISSING",
    "missingRequiredNameBlocksBeforeCloudflareRequest": true
  },
  "productionPreflight": {
    "publicWorkerIdentityRequired": true,
    "privateWorkerIdentityRequired": true,
    "bothWorkersMustBeAtOneHundredPercentTraffic": true,
    "bindingSnapshotRequiredBeforeMutation": true,
    "concurrentChangeDetectionRequired": true,
    "artifactMetadataApiMethod": "GET",
    "artifactMetadataRedirectsAllowed": false
  },
  "configurationPreservation": {
    "existingVariablesPreserved": true,
    "existingSecretValuesPreserved": true,
    "existingBindingsPreserved": true,
    "durableObjectBindingsPreserved": true,
    "durableObjectMigrationHistoryPreserved": true,
    "routesPreserved": true,
    "publicWorkerPreserved": true,
    "bindingTransition": {
      "everyPreexistingBindingRequired": true,
      "qualifiedConfiguredAdditionsAllowed": true,
      "runtimeGuardPlainTextAdditionsAllowed": [
        "PROMETHEUS_UNATTENDED_SMOKE_GUARD",
        "PROMETHEUS_UNATTENDED_SMOKE_ACCESS_TEAM_DOMAIN",
        "PROMETHEUS_UNATTENDED_SMOKE_ACCESS_AUDIENCE",
        "PROMETHEUS_UNATTENDED_SMOKE_SERVICE_TOKEN_CLIENT_ID"
