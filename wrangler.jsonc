{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prometheus-iq",
  "main": "workers/prometheus-iq-worker.js",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./deploy/cloudflare-pages",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "META_OAUTH_CALLBACK_URL": "https://prometheusrouteiq.com/api/oauth/meta/instagram/callback",
    "META_GRAPH_API_VERSION": "v21.0"
  },
  "kv_namespaces": [
    {
      "binding": "META_INSTAGRAM_TOKEN_STORE",
      "id": "9bc431ce712544bfa18dae1b6d59e19b"
    }
  ]
  // The Worker intentionally fails closed until required Meta/Instagram secrets
  // and META_INSTAGRAM_TOKEN_ENCRYPTION_KEY are configured through Cloudflare.
}
