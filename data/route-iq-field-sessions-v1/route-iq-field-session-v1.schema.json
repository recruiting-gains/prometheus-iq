{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometheus-data-route-iq-field-session-v1",
  "title": "Prometheus Data Route IQ Field Session v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "handoffContractId",
    "sessionId",
    "workspaceId",
    "operatingProfileId",
    "recordKind",
    "verifiedFields",
    "unavailableFields",
    "sourceProvenance",
    "fieldClassification"
  ],
  "properties": {
    "schemaVersion": { "const": "route-iq-field-session-archive-v1" },
    "handoffContractId": { "const": "route-iq-end-of-day-data-handoff-v1" },
    "sessionId": { "type": "string", "minLength": 1 },
    "workspaceId": { "const": "fitness_connection" },
    "operatingProfileId": { "const": "fitness" },
    "recordKind": { "const": "verified_field_session" },
    "verifiedFields": {
      "type": "object",
      "required": ["representative", "fieldSessionDate", "sourceReportType", "exportTimestamp", "totals", "completedVisits"],
      "properties": {
        "completedVisits": {
          "type": "array"
        }
      }
    },
    "unavailableFields": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "sourceProvenance": {
      "type": "object",
      "required": ["sourceKind", "canonicalRawArtifactPath", "rawSha256", "rawByteLength", "finalExportConfirmed"]
    },
    "fieldClassification": {
      "type": "object",
      "required": ["verifiedFieldContainer", "calculatedFieldsStoredSeparately", "unavailableValuesRemainNull"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sessionId": { "const": "route-iq-field-session-fitness-connection-fitness-cruz-2026-07-11" },
          "sourceProvenance": {
            "type": "object",
            "required": ["rawSha256"],
            "properties": {
              "rawSha256": { "const": "a62ec0643d61c8280e0e23dcd8616894a30a421dc9150281fb7cad334f5c0e6a" }
            }
          }
        },
        "required": ["sessionId", "sourceProvenance"]
      },
      "then": {
        "properties": {
          "verifiedFields": {
            "properties": {
              "completedVisits": {
                "items": { "$ref": "#/$defs/legacyCompletedVisit" }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "verifiedFields": {
            "properties": {
              "completedVisits": {
                "items": { "$ref": "#/$defs/completedVisit" }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "completedVisit": {
      "type": "object",
      "description": "A newly normalized completed visit. Decision context is captured with visit completion and is post-action observational evidence, not a frozen pre-action candidate snapshot.",
      "required": ["visitDecisionSource", "recommendationDecisionContext"],
      "properties": {
        "visitDecisionSource": { "$ref": "#/$defs/visitDecisionSource" },
        "recommendationDecisionContext": { "$ref": "#/$defs/recommendationDecisionContext" }
      },
      "additionalProperties": true
    },
    "legacyCompletedVisit": {
      "type": "object",
      "additionalProperties": true
    },
    "visitDecisionSource": {
      "type": "object",
      "description": "Representative-reported decision source captured atomically with the completed visit. Runtime normalization requires capturedAt to equal the completed visit timestamp.",
      "required": ["sourceId", "reason", "evidence", "confidence", "capturedAt"],
      "properties": {
        "sourceId": {
          "enum": [
            "route_iq_recommendation",
            "nearby_context",
            "representative_saved_place",
            "representative_discovery",
            "representative_follow_up",
            "existing_relationship",
            "manual_selection",
            "unknown"
          ]
        },
        "reason": { "type": ["string", "null"] },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["evidenceType", "sourceRecordId"],
            "properties": {
              "evidenceType": { "type": "string", "pattern": ".*\\S.*" },
              "sourceRecordId": { "type": "string", "pattern": ".*\\S.*" }
            },
            "additionalProperties": true
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "capturedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "sourceId": { "const": "unknown" } },
            "required": ["sourceId"]
          },
          "then": {
            "properties": {
              "reason": { "const": null },
              "confidence": { "const": 0 }
            }
          },
          "else": {
            "properties": {
              "reason": { "type": "string", "pattern": ".*\\S.*" },
              "evidence": { "minItems": 1 }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "recommendationDecisionContext": {
      "type": "object",
      "required": ["recommendationAvailable", "recommendationId", "decision"],
      "properties": {
        "recommendationAvailable": { "type": ["boolean", "null"] },
        "recommendationId": { "type": ["string", "null"], "pattern": ".*\\S.*" },
        "decision": { "enum": ["accepted", "overridden", null] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "recommendationAvailable": { "const": true } },
            "required": ["recommendationAvailable"]
          },
          "then": {
            "properties": { "recommendationId": { "type": "string", "pattern": ".*\\S.*" } }
          }
        },
        {
          "if": {
            "properties": { "recommendationAvailable": { "enum": [false, null] } },
            "required": ["recommendationAvailable"]
          },
          "then": {
            "properties": { "recommendationId": { "type": "null" } }
          }
        },
        {
          "if": {
            "properties": { "decision": { "enum": ["accepted", "overridden"] } },
            "required": ["decision"]
          },
          "then": {
            "properties": {
              "recommendationAvailable": { "const": true },
              "recommendationId": { "type": "string", "pattern": ".*\\S.*" }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
