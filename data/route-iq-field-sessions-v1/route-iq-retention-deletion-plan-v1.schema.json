{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route-iq-retention-deletion-plan-v1.schema.json",
  "title": "Route IQ Retention Deletion Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "policyVersion",
    "mode",
    "workspaceId",
    "operatingProfileId",
    "recordClass",
    "sessionId",
    "representativeIdentitySha256",
    "sourceRecordSha256",
    "retentionBoundary",
    "authoritativeEvaluationTime",
    "legalHoldSnapshotIdentitySha256",
    "artifacts",
    "totalArtifactCount",
    "totalByteLength",
    "planSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "route-iq-retention-deletion-plan-v1" },
    "planId": { "type": "string", "pattern": "^riq_retention_deletion_plan_[a-f0-9]{64}$" },
    "policyVersion": { "const": "route-iq-prospective-shadow-retention-policy-v1" },
    "mode": { "enum": ["dry_run", "execution"] },
    "workspaceId": { "const": "fitness_connection" },
    "operatingProfileId": { "const": "fitness" },
    "recordClass": { "const": "field_session_raw_evidence" },
    "sessionId": { "type": "string", "minLength": 1 },
    "representativeIdentitySha256": { "$ref": "#/$defs/sha256" },
    "sourceRecordSha256": { "$ref": "#/$defs/sha256" },
    "retentionBoundary": { "type": "object" },
    "authoritativeEvaluationTime": { "type": "string", "format": "date-time" },
    "legalHoldSnapshotIdentitySha256": { "$ref": "#/$defs/sha256" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "totalArtifactCount": { "type": "integer", "minimum": 1 },
    "totalByteLength": { "type": "integer", "minimum": 0 },
    "planSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "storageClass",
        "key",
        "rowIdentity",
        "artifactIdentitySha256",
        "artifactSha256",
        "byteLength",
        "relationship"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "storageClass": { "enum": ["field_session_kv", "prospective_coordinator_sqlite"] },
        "key": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "rowIdentity": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["table", "primaryKeyColumn", "primaryKey"],
              "properties": {
                "table": { "type": "string", "pattern": "^[a-z_]+$" },
                "primaryKeyColumn": { "type": "string", "pattern": "^[a-z_]+$" },
                "primaryKey": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "artifactIdentitySha256": { "$ref": "#/$defs/sha256" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 0 },
        "relationship": { "type": "string", "pattern": "^[a-z0-9_]+$" }
      }
    }
  }
}
