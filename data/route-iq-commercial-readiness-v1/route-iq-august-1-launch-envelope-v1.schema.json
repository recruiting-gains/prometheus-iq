{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometheus.local/schemas/route-iq-august-1-launch-envelope-v1.schema.json",
  "title": "Route IQ August 1 Bounded Production Activation Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "state", "classification", "issuedAt", "expiresAt", "limits", "safety", "workspaceAdmissions"],
  "properties": {
    "version": { "const": "route-iq-august-1-launch-envelope-v1" },
    "state": { "enum": ["OFF", "ACTIVE"] },
    "classification": { "const": "PRODUCTION_ACTIVATION" },
    "issuedAt": { "type": ["string", "null"], "format": "date-time" },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumCompanies", "maximumNamedUsers"],
      "properties": {
        "maximumCompanies": { "const": 2 },
        "maximumNamedUsers": { "const": 40 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prelaunchHumanAcceptanceTester", "externalHumanTesting", "anthonyMapped", "prospectiveCollection", "activeCohorts", "recommendationInfluence"],
      "properties": {
        "prelaunchHumanAcceptanceTester": { "const": "cruz" },
        "externalHumanTesting": { "const": false },
        "anthonyMapped": { "const": false },
        "prospectiveCollection": { "const": "OFF" },
        "activeCohorts": { "const": 0 },
        "recommendationInfluence": { "const": "OFF" }
      }
    },
    "workspaceAdmissions": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workspaceId", "operatingProfileId", "authorizedUserIds", "runtimeAssets"],
        "properties": {
          "workspaceId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$" },
          "operatingProfileId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$" },
          "authorizedUserIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$" }
          },
          "runtimeAssets": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fullPool", "activePool", "quarantinePool", "businessHours"],
            "properties": {
              "fullPool": { "type": "string", "pattern": "^/data/[a-z0-9][a-z0-9_./-]+\\.json$" },
              "activePool": { "type": "string", "pattern": "^/data/[a-z0-9][a-z0-9_./-]+\\.json$" },
              "quarantinePool": { "type": "string", "pattern": "^/data/[a-z0-9][a-z0-9_./-]+\\.json$" },
              "businessHours": { "type": "string", "pattern": "^/data/[a-z0-9][a-z0-9_./-]+\\.json$" }
            }
          }
        }
      }
    }
  }
}
