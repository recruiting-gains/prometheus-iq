{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometheus.local/schemas/route-iq-verified-business-eligibility-policy-v1.schema.json",
  "title": "Route IQ Verified Business Eligibility Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "policyVersion",
    "companyId",
    "workspaceId",
    "authorizedTerritories",
    "includedCategoryIds",
    "excludedCategoryIds",
    "excludedBusinessIds",
    "maximumFreshnessHours",
    "minimumEvidenceQuality"
  ],
  "properties": {
    "schemaVersion": { "const": "route-iq-verified-business-eligibility-policy-v1" },
    "policyId": { "$ref": "#/$defs/opaqueId" },
    "policyVersion": { "type": "string", "pattern": "^v[1-9][0-9]{0,8}$" },
    "companyId": { "$ref": "#/$defs/opaqueId" },
    "workspaceId": { "$ref": "#/$defs/opaqueId" },
    "authorizedTerritories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["territoryId", "postalCodes"],
        "properties": {
          "territoryId": { "$ref": "#/$defs/opaqueId" },
          "postalCodes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9 -]{1,11}$"
            }
          }
        }
      }
    },
    "includedCategoryIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/opaqueId" }
    },
    "excludedCategoryIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/opaqueId" }
    },
    "excludedBusinessIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/opaqueId" }
    },
    "maximumFreshnessHours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24
    },
    "minimumEvidenceQuality": {
      "enum": ["LOW", "MEDIUM", "HIGH"]
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,127}$"
    }
  }
}
