{
  "name": "prometheus-iq-public-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "node scripts/lint-crm.mjs",
    "typecheck": "node scripts/typecheck-crm.mjs",
    "security:check": "node scripts/security-check.mjs",
    "dashboard:runtime-pool:check": "node scripts/verify-dashboard-runtime-pool-consumption.mjs",
    "dashboard:runtime-workflows:check": "node scripts/verify-dashboard-runtime-workflows.mjs",
    "intelligence:route-quality:check": "node scripts/verify-route-intelligence-quality-gate.mjs",
    "intelligence:architecture:validate": "node scripts/validate-intelligence-architecture.mjs",
    "research:validate": "node scripts/validate-research-foundation.mjs",
    "crm:validate": "node scripts/validate-crm-enterprise-foundation.mjs",
    "test:intelligence:route-quality": "node --test tests/route-intelligence-quality-gate.test.mjs",
    "test:intelligence:architecture": "node --test tests/intelligence-architecture.test.mjs",
    "test:crm": "node --test tests/crm-foundation.test.mjs tests/crm-enterprise-foundation.test.mjs",
    "test:integrations": "node --test tests/founder-communications-contract.test.mjs tests/founder-communications-provider-adapters.test.mjs",
    "test:research": "node --test tests/research-foundation.test.mjs",
    "test:social-media": "node --test tests/social-media-contract.test.mjs tests/meta-instagram-worker-callback.test.mjs tests/founder-marketing-operating-system.test.mjs tests/founder-instagram-analytics-reporting-view.test.mjs",
    "test:website": "node --test tests/website-social-attribution.test.mjs",
    "data:refresh-google": "node scripts/refresh-google-qualified-businesses.mjs",
    "data:refresh-google:dry-run": "node scripts/refresh-google-qualified-businesses.mjs --dry-run",
    "verify:zero-google-api": "node scripts/verify-zero-live-google-api-calls.mjs",
    "verify:production-release": "node scripts/verify-production-release.mjs",
    "verify:production-release:local": "node scripts/verify-production-release.mjs --local-only",
    "instagram:verify-token": "node scripts/verify-instagram-business-token.mjs",
    "test": "npm run security:check && npm run dashboard:runtime-pool:check && npm run dashboard:runtime-workflows:check && npm run intelligence:route-quality:check && npm run intelligence:architecture:validate && npm run research:validate && npm run crm:validate && npm run test:intelligence:route-quality && npm run test:intelligence:architecture && npm run test:crm && npm run test:integrations && npm run test:research && npm run test:social-media && npm run test:website && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "framer-motion": "^12.40.0",
    "gsap": "^3.13.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "vite": "^6.1.0"
  }
}
