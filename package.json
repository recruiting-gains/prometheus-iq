{
  "name": "prometheus-iq-public-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "node scripts/lint-crm.mjs",
    "typecheck": "node scripts/typecheck-crm.mjs",
    "test": "npm run test:core && npm run test:public && npm run test:private && npm run test:security && npm run test:release",
    "test:core": "node scripts/run-test-suite.mjs core",
    "test:public": "node scripts/run-test-suite.mjs public",
    "test:private": "node scripts/run-test-suite.mjs private",
    "test:security": "node scripts/run-test-suite.mjs security",
    "test:release": "node scripts/run-test-suite.mjs release",
    "test:historical": "node scripts/run-test-suite.mjs historical",
    "security:check": "node scripts/security-check.mjs",
    "security:aegis:verify": "node scripts/verify-aegis-security-foundation.mjs",
    "overwatch:auto-push-governance:check": "node scripts/verify-overwatch-auto-push-governance.mjs",
    "overwatch:artifact-contracts:check": "node scripts/verify-cross-subsystem-artifact-contracts.mjs",
    "early-handoff:verify": "node scripts/verify-early-github-handoff-v1.mjs && node scripts/verify-overwatch-early-github-handoff-v1.mjs",
    "early-handoff:dispatch": "node scripts/run-early-github-handoff-v1.mjs",
    "infrastructure:route-iq-prospective-shadow:check": "node scripts/verify-route-iq-prospective-shadow-infrastructure.mjs",
    "infrastructure:route-iq-public-deployment-assets:check": "node scripts/verify-route-iq-public-deployment-assets.mjs",
    "infrastructure:cloudflare-toolchain-harness:check": "node --test tests/cloudflare-unattended-runtime-guard.test.mjs tests/route-iq-business-availability-infrastructure.test.mjs tests/route-iq-prospective-shadow-infrastructure.test.mjs tests/route-iq-request-crm-infrastructure.test.mjs",
    "infrastructure:cloudflare-toolchain-compatibility:check": "node --test tests/route-iq-cloudflare-toolchain-compatibility.test.mjs && npm run infrastructure:cloudflare-toolchain-harness:check",
    "infrastructure:cloudflare-unattended-access:check": "node scripts/verify-cloudflare-unattended-access-architecture.mjs && node scripts/check-cloudflare-unattended-secret-presence.mjs",
    "infrastructure:cloudflare-unattended-access:preflight": "node scripts/verify-cloudflare-unattended-access-architecture.mjs --require-ready && node scripts/check-cloudflare-unattended-secret-presence.mjs --source=both --require-present",
    "infrastructure:cloudflare-unattended-runtime-guard:check": "node scripts/verify-cloudflare-unattended-runtime-guard.mjs",
    "infrastructure:cloudflare-founder-attended:check": "node scripts/verify-cloudflare-founder-attended-service-token.mjs",
    "infrastructure:cloudflare-founder-attended:presence": "node scripts/run-cloudflare-founder-attended-service-token.mjs presence",
    "infrastructure:cloudflare-founder-attended:provision-attended": "node scripts/run-cloudflare-founder-attended-service-token.mjs provision-attended",
    "infrastructure:cloudflare-founder-attended:cleanup-temp": "node scripts/run-cloudflare-founder-attended-service-token.mjs cleanup-temp",
    "infrastructure:field-session-store:remote": "node scripts/verify-route-iq-field-session-store-binding.mjs --remote-probe",
    "infrastructure:route-iq-forward-rollback:prepare": "node scripts/build-route-iq-forward-rollback-candidate.mjs",
    "infrastructure:route-iq-forward-rollback:dry-run": "node scripts/build-route-iq-forward-rollback-candidate.mjs --dry-run",
    "infrastructure:route-iq-forward-rollback:check": "node scripts/verify-route-iq-forward-rollback-candidate.mjs",
    "intelligence:route-quality:check": "node scripts/verify-route-intelligence-quality-gate.mjs",
    "crm:validate": "node scripts/validate-crm-enterprise-foundation.mjs && node scripts/validate-crm-production-store.mjs",
    "data:refresh-google": "node scripts/refresh-google-qualified-businesses.mjs",
    "data:refresh-google:dry-run": "node scripts/refresh-google-qualified-businesses.mjs --dry-run",
    "data:business-hours:refresh": "node scripts/refresh-google-business-hours.mjs",
    "data:business-hours:dry-run": "node scripts/refresh-google-business-hours.mjs --dry-run",
    "data:business-hours:evaluate": "node scripts/refresh-google-business-hours.mjs --evaluate-only",
    "data:commercial-centers:generate": "node scripts/build-commercial-center-intelligence.mjs --write",
    "data:field-session:ingest": "node scripts/ingest-route-iq-field-session.mjs",
    "data:route-quality:generate": "node scripts/verify-route-intelligence-quality-gate.mjs --write-report",
    "verify:zero-google-api": "node scripts/verify-zero-live-google-api-calls.mjs",
    "verify:production-release": "node scripts/verify-production-release.mjs",
    "verify:production-release:local": "node scripts/verify-production-release.mjs --local-only",
    "verify:production-read-only-mobile": "node scripts/verify-production-read-only-mobile.mjs",
    "verify:authenticated-production": "node scripts/verify-authenticated-production-access.mjs",
    "instagram:verify-token": "node scripts/verify-instagram-business-token.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "framer-motion": "^12.40.0",
    "gsap": "^3.13.0",
    "jose": "^6.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "jsonc-parser": "3.2.0",
    "miniflare": "5.20260804.0-alpha",
    "vite": "^6.1.0",
    "wrangler": "4.120.1"
  }
}
