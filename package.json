{
  "name": "prometheus-iq-public-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "security:check": "node scripts/security-check.mjs",
    "dashboard:runtime-pool:check": "node scripts/verify-dashboard-runtime-pool-consumption.mjs",
    "dashboard:runtime-workflows:check": "node scripts/verify-dashboard-runtime-workflows.mjs",
    "data:refresh-google": "node scripts/refresh-google-qualified-businesses.mjs",
    "data:refresh-google:dry-run": "node scripts/refresh-google-qualified-businesses.mjs --dry-run",
    "verify:zero-google-api": "node scripts/verify-zero-live-google-api-calls.mjs",
    "verify:production-release": "node scripts/verify-production-release.mjs",
    "verify:production-release:local": "node scripts/verify-production-release.mjs --local-only",
    "test": "npm run security:check && npm run dashboard:runtime-pool:check && npm run dashboard:runtime-workflows:check && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "framer-motion": "^12.40.0",
    "gsap": "^3.13.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "vite": "^6.1.0"
  }
}
