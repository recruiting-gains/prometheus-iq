  "confidenceModel": {
    "requiredFieldsPerRecommendation": [
      "evidenceQuality",
      "sourceReliability",
      "confidence",
      "businessImpact",
      "verificationPriority"
    ],
    "levels": [
      {
        "level": "High",
        "definition": "Multiple reliable public sources support the conclusion and no material contradiction is known."
      },
      {
        "level": "Medium-high",
        "definition": "Credible public evidence supports the conclusion, but at least one key operating or intent unknown remains."
      },
      {
        "level": "Medium",
        "definition": "The conclusion is plausible but relies on limited public sources or one major assumption."
      },
      {
        "level": "Low",
        "definition": "The conclusion is speculative and should not guide outreach without more evidence."
      }
    ]
  },
