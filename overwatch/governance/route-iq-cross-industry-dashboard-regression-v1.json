  "rootCauses": [
    {
      "id": "DUPLICATE_EMBEDDED_BUSINESS_CATALOGS",
      "finding": "The Dashboard contained embedded business arrays and silently used them after governed runtime-load failures.",
      "repair": "Business records now originate only from the Data manifest selected by the authenticated Administration workspace."
    },
    {
      "id": "CUSTOMER_WORKSPACE_REMAINED_CANONICAL",
      "finding": "The cross-subsystem registry continued authorizing an inactive customer-specific workspace and its generated artifacts.",
      "repair": "The canonical registry now contains only Founder research and a nonproduction synthetic outside-sales validation profile."
    },
    {
      "id": "STALE_HOURS_TREATED_AS_ROUTE_COVERAGE",
      "finding": "Prior eligibility logic treated any state other than verified closed as eligible and used a 168-hour freshness policy.",
      "repair": "The v2 policy separates coverage from immediate eligibility and caps freshness at 24 hours."
    },
    {
      "id": "STATIC_HOURS_PROJECTION_WITHOUT_RUNTIME_REFRESH",
      "finding": "Availability existed only as a build-time artifact with no governed refresh store, outbox, monitoring, or scheduler package.",
      "repair": "Infrastructure owns an idempotent default-OFF runtime refresh projection and activation package."
    },
    {
      "id": "CACHE_AND_CONFIGURATION_PRECEDENCE_UNGOVERNED",
      "finding": "Old service-worker and browser state could outlive a configuration or business-manifest transition.",
      "repair": "The generic PWA uses versioned cache/storage migration and network-only governed runtime assets."
    }
  ],
