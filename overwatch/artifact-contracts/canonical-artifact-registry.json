      "auditFindings": {
        "brokenLinksIdentified": [],
        "incompleteLinksIdentified": [
          "Cranky Carrot and LEEMOO mission slots have no completed canonical Research-owned dossier yet and must remain fail-closed.",
          "CRM durable candidate persistence is not authorized; CRM currently owns handoff consumption contracts and workspace-scoped library behavior only.",
